# hunt-a1.conf — Configuration for the OCI A1 Capacity Hunter
#
# Setup:
#   1. Copy this file:  cp hunt-a1.conf.example ~/hunt-a1.conf
#   2. Fill in your Oracle Cloud values (see instructions below each var)
#   3. Lock permissions: chmod 600 ~/hunt-a1.conf
#
# Tip: run `oci setup config` first if you haven't configured the OCI CLI yet.

# === OCI Resource IDs ===

# Compartment OCID — OCI Console > Identity > Compartments > your compartment > copy OCID
COMPARTMENT_ID="ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Subnet OCID — OCI Console > Networking > Virtual Cloud Networks > your VCN > Subnets > copy OCID
SUBNET_ID="ocid1.subnet.oc1.<your-region>.xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Image OCID — OCI Console > Compute > Images > pick your OS > copy OCID
# Quick way:  oci compute image list --compartment-id $COMPARTMENT_ID \
#               --shape "VM.Standard.A1.Flex" --operating-system "Canonical Ubuntu" \
#               --query 'data[0].id' --raw-output
IMAGE_ID="ocid1.image.oc1.<your-region>.xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Availability Domains ===
# List yours:  oci iam availability-domain list --query 'data[].name' --output table
# Most regions have 1–3 ADs. Only set what exists in your region.
AD_1="xxxx:YOUR-REGION-AD-1"
AD_2="xxxx:YOUR-REGION-AD-2"
AD_3="xxxx:YOUR-REGION-AD-3"
# Single-AD region? Leave AD_2 and AD_3 empty:
#   AD_2=""
#   AD_3=""

# === Instance Configuration ===
# Free Tier allowance (since June 15, 2026): 2 OCPU + 12 GB RAM total across all
# A1 instances, max 2 instances. You can split this (2 x 1 OCPU / 6 GB) or use
# one instance (1 x 2 OCPU / 12 GB — the defaults below).
# IMPORTANT: requesting more than 2 OCPU / 12 GB on a Free Tier account fails
# with LimitExceeded on every attempt (the capacity hunt can never succeed).
# Pay As You Go accounts may have higher A1 limits (the old 4 / 24 is not
# officially confirmed post-June 2026) — check your tenancy's service limits.
INSTANCE_NAME="my-a1-server"
SHAPE="VM.Standard.A1.Flex"
OCPUS=2
MEMORY_GB=12
SSH_KEY_PATH="$HOME/.ssh/id_ed25519.pub"

# === Circuit Breaker ===
# Stop hunting after this many CONSECUTIVE fatal errors (LimitExceeded,
# NotAuthorizedOrNotFound, InvalidParameter...). These errors mean the config
# is wrong — retrying forever only spams Oracle's API and your inbox.
# When tripped: the cron entry is removed, ONE alert email is sent, and
# ~/.hunt-a1.fatal is created. Fix your config, then: rm ~/.hunt-a1.fatal
MAX_CONSECUTIVE_FATALS=30

# === Email Notifications (optional) ===
# Leave all three empty to skip email — the script works fine without it.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=""
SMTP_PASS=""
NOTIFY_TO=""
# Defaults to Gmail SMTP. Change if using another provider:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
